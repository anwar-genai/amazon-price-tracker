{
    "manifest_version": 3,
    "name": "Amazon Price Tracker",
    "version": "1.0.0",
    "description": "Track Amazon product prices and get alerts when prices drop",
    "permissions": [
      "storage",
      "notifications",
      "alarms"
    ],
    "host_permissions": [
      "https://www.amazon.com/*",
      "http://localhost:8000/*"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
      }
    },
    "content_scripts": [
      {
        "matches": ["https://www.amazon.com/*"],
        "js": ["content.js"],
        "css": ["content.css"]
      }
    ],
    "icons": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }